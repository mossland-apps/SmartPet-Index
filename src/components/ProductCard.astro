---
import ProductArt from './ProductArt.astro';
import BuyButtons from './BuyButtons.astro';
import { overallScore, formatScore, scoreLabel, scoreBand } from '../lib/scoring.js';
import { getBrand } from '../lib/catalog.js';

const { product, award = null, rank = null } = Astro.props;
const overall = overallScore(product.scores);
const brand = getBrand(product.brand);
const href = '/reviews/' + product.slug + '/';
---

<article class="card">
  {award && <p class="award">{award}</p>}

  <a class="art-link" href={href}>
    <ProductArt product={product} size={150} />
  </a>

  <p class="brand">{brand ? brand.name : product.brand}</p>
  <h3 class="name"><a href={href}>{product.shortName || product.model}</a></h3>

  <div class="meta">
    <div class={'score ' + 'is-' + scoreBand(overall)}>
      <span class="score-value">{formatScore(overall)}</span>
      <span class="score-caption">Overall</span>
    </div>
    <div class="meta-text">
      <p class="verdict-word">{scoreLabel(overall)}</p>
      <p class="price">${product.price}</p>
    </div>
  </div>

  <p class="line">{product.bestFor[0]}</p>

  <div class="actions">
    <BuyButtons product={product} compact={true} />
    <a class="btn btn-outline btn-block read" href={href}>Read the Review</a>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 2px solid var(--blue-100);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: 18px 18px 20px;
    height: 100%;
    position: relative;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .card:hover {
    border-color: var(--blue-500);
    box-shadow: var(--shadow-raised);
  }

  .award {
    position: absolute;
    top: -12px;
    left: 14px;
    margin: 0;
    background: var(--coral);
    color: #fff;
    font-family: var(--display);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 4px;
  }

  .art-link {
    display: block;
    padding: 10px 0 6px;
  }

  .brand {
    margin: 0;
    font-family: var(--display);
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--sage-600);
  }

  .name {
    margin: 3px 0 12px;
    font-size: 1.22rem;
    line-height: 1.2;
  }

  .name a {
    color: var(--ink);
  }

  .name a:hover {
    color: var(--blue-700);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-soft);
  }

  .meta-text p {
    margin: 0;
  }

  .verdict-word {
    font-family: var(--display);
    font-size: 0.95rem;
    color: var(--ink);
  }

  .price {
    color: var(--ink-soft);
    font-size: 0.88rem;
  }

  .line {
    margin: 12px 0 16px;
    font-size: 0.9rem;
    color: var(--ink-soft);
    flex: 1;
  }

  .actions {
    display: grid;
    gap: 8px;
  }

  .read {
    padding: 9px 14px;
    font-size: 0.88rem;
  }
</style>
