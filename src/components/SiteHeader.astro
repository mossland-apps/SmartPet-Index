---
import { SITE, NAV } from '../config/site.js';
const { pathname } = Astro.url;
---

<header class="site-header">
  <div class="bar">
    <div class="wrap bar-inner">
      <a class="wordmark" href="/">
        <span class="wm-first">{SITE.wordmark.first}</span><span class="wm-second">{SITE.wordmark.second}</span>
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
        <span class="menu-bars" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="menu-word">Menu</span>
      </button>

      <nav id="primary-nav" class="nav" aria-label="Primary">
        <ul class="nav-list">
          {
            NAV.map((item) => (
              <li class={item.columns ? 'nav-item has-menu' : 'nav-item'}>
                <a
                  class="nav-link"
                  href={item.href}
                  aria-current={pathname.startsWith(item.href) && item.href !== '/' ? 'page' : undefined}
                >
                  {item.label}
                  {item.columns && <span class="caret" aria-hidden="true" />}
                </a>
                {item.columns && (
                  <div class="mega">
                    <div class="mega-inner wrap">
                      {item.columns.map((col) => (
                        <div class="mega-col">
                          <p class="mega-heading">{col.heading}</p>
                          <ul>
                            {col.links.map((l) => (
                              <li>
                                <a href={l.href}>{l.label}</a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 50;
  }

  .bar {
    background: var(--blue-600);
    position: relative;
  }

  .bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 62px;
  }

  .wordmark {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.42rem;
    letter-spacing: 0.045em;
    color: #fff;
    white-space: nowrap;
    padding: 6px 0;
  }

  .wordmark:hover {
    text-decoration: none;
  }

  .wm-second {
    color: var(--sage-300);
    margin-left: 0.32em;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 5px;
    color: #fff;
    font-family: var(--display);
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 8px 12px;
    cursor: pointer;
  }

  .menu-bars {
    display: inline-flex;
    flex-direction: column;
    gap: 3px;
  }

  .menu-bars i {
    display: block;
    width: 17px;
    height: 2px;
    background: #fff;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    position: static;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--display);
    font-weight: 500;
    font-size: 0.92rem;
    letter-spacing: 0.075em;
    text-transform: uppercase;
    color: #fff;
    padding: 20px 13px;
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    background: rgba(255, 255, 255, 0.14);
    text-decoration: none;
  }

  .caret {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid currentColor;
    opacity: 0.85;
  }

  .mega {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: #fff;
    border-bottom: 3px solid var(--blue-600);
    box-shadow: var(--shadow-raised);
  }

  .has-menu:hover .mega,
  .has-menu:focus-within .mega,
  .has-menu.is-open .mega {
    display: block;
  }

  .mega-inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 34px;
    padding-top: 24px;
    padding-bottom: 26px;
  }

  .mega-heading {
    font-family: var(--display);
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sage-600);
    margin: 0 0 10px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }

  .mega-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mega-col li + li {
    margin-top: 7px;
  }

  .mega-col a {
    color: var(--ink);
    font-size: 0.95rem;
  }

  .mega-col a:hover {
    color: var(--blue-700);
  }

  @media (max-width: 900px) {
    .menu-toggle {
      display: inline-flex;
    }

    .bar-inner {
      flex-wrap: wrap;
      min-height: 56px;
    }

    .nav {
      display: none;
      width: 100%;
      order: 3;
      border-top: 1px solid rgba(255, 255, 255, 0.25);
    }

    .nav.is-open {
      display: block;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-bottom: 10px;
    }

    .nav-link {
      padding: 13px 2px;
      justify-content: space-between;
      border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    }

    .mega {
      display: block;
      position: static;
      background: transparent;
      border: 0;
      box-shadow: none;
    }

    .mega-inner {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 14px 0 18px;
    }

    .mega-heading {
      color: var(--sage-300);
      border-bottom-color: rgba(255, 255, 255, 0.2);
    }

    .mega-col a {
      color: rgba(255, 255, 255, 0.92);
      font-size: 0.94rem;
    }

    .mega-col a:hover {
      color: #fff;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const nav = document.getElementById('primary-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  // CSS :hover alone already works now that the dropdown sits flush under the bar,
  // so this is belt and braces: a short grace period on the way out means a fast or
  // slightly diagonal pointer does not drop the menu mid-move.
  const CLOSE_DELAY = 220;
  for (const item of document.querySelectorAll('.nav-item.has-menu')) {
    let timer;
    const open = () => {
      clearTimeout(timer);
      item.classList.add('is-open');
    };
    const close = () => {
      clearTimeout(timer);
      timer = setTimeout(() => item.classList.remove('is-open'), CLOSE_DELAY);
    };
    item.addEventListener('mouseenter', open);
    item.addEventListener('mouseleave', close);
    item.addEventListener('focusin', open);
    item.addEventListener('focusout', close);
  }

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const item of document.querySelectorAll('.nav-item.has-menu.is-open')) {
      item.classList.remove('is-open');
    }
  });
</script>
