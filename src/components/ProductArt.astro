---
// Illustrated stand-ins until we photograph our own test units.
// Geometry lives in src/lib/product-art.js so the generated social and product
// images render from exactly the same source.
import { ART_VIEWBOX, productArtMarkup } from '../lib/product-art.js';

const { product, size = 160 } = Astro.props;
const markup = productArtMarkup(product);
const height = Math.round((size * ART_VIEWBOX.height) / ART_VIEWBOX.width);
---

<svg
  class="art"
  viewBox={`0 0 ${ART_VIEWBOX.width} ${ART_VIEWBOX.height}`}
  width={size}
  height={height}
  role="img"
  aria-label={product.model + ' illustration'}
  set:html={markup}
/>

<style>
  .art {
    display: block;
    margin: 0 auto;
  }
</style>
