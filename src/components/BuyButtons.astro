---
import { retailerLinks } from '../lib/retailers.js';
const { product, compact = false } = Astro.props;
const links = retailerLinks(product);
---

<div class={compact ? 'buy compact' : 'buy'}>
  {
    links.map((link, i) => (
      <a
        class={'btn btn-block ' + (i === 0 ? 'btn-primary' : 'btn-outline')}
        href={link.href}
        rel={link.rel}
        target="_blank"
      >
        Check Price at {link.name}
      </a>
    ))
  }
</div>

<style>
  .buy {
    display: grid;
    gap: 8px;
  }

  .compact :global(.btn) {
    padding: 9px 14px;
    font-size: 0.88rem;
  }
</style>
