---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { products, brands, getBrand } from '../../lib/catalog.js';
import { getHub, commonIntro, commonSymptoms } from '../../lib/troubleshooting.js';
import { troubleshootingPath } from '../../lib/routes.js';

const SEVERITY = { serious: 'Stop and check', normal: 'Normal behaviour', common: 'Common' };

const hubs = products
  .map((p) => ({ product: p, hub: getHub(p.slug) }))
  .filter((x) => x.hub);

const byBrand = brands
  .map((b) => ({ brand: b, items: hubs.filter((h) => h.product.brand === b.slug) }))
  .filter((g) => g.items.length);

const totalSymptoms = hubs.reduce((n, h) => n + h.hub.symptoms.length, 0);
---

<BaseLayout
  title="Litter Box Troubleshooting"
  description="Fix automatic litter box problems by model: flashing lights, failed cycles, wrong weight readings, offline units, drawer errors and persistent odor."
>
  <PageHeader
    eyebrow="Help"
    title="Litter Box Troubleshooting"
    lede="Pick your model for problems specific to it, or start with the common problems below — they cause the same symptoms on almost every automatic litter box."
    crumbs={[{ label: 'Troubleshooting' }]}
  >
    <ul class="stats">
      <li><strong>{hubs.length}</strong> models covered</li>
      <li><strong>{totalSymptoms}</strong> model-specific problems</li>
      <li><strong>{commonSymptoms.length}</strong> common problems</li>
    </ul>
  </PageHeader>

  <section class="section">
    <div class="wrap">
      {
        byBrand.map((group) => (
          <div class="group">
            <h2>{group.brand.name}</h2>
            <div class="cards">
              {group.items.map(({ product, hub }) => (
                <a class="card" href={troubleshootingPath(product.slug)}>
                  <span class="model">{product.model}</span>
                  <span class="count">
                    {hub.symptoms.length > 0
                      ? hub.symptoms.length + ' model-specific problems'
                      : 'Common problems and where to get help'}
                  </span>
                  <ul class="preview">
                    {hub.symptoms.slice(0, 4).map((s) => (
                      <li>{s.title}</li>
                    ))}
                  </ul>
                  <span class="cta">Open the hub →</span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section section-soft" id="common">
    <div class="wrap common">
      <h2 class="common-title">Common problems on any automatic litter box</h2>
      <p class="lede">{commonIntro}</p>

      {
        commonSymptoms.map((s) => (
          <article class="symptom" id={s.slug}>
            <div class="sym-head">
              <h3>{s.title}</h3>
              <span class={'badge ' + (s.severity === 'serious' ? 'badge-serious' : 'badge-sage')}>
                {SEVERITY[s.severity] || 'Common'}
              </span>
            </div>
            <p class="summary">{s.summary}</p>
            <div class="cols">
              <div>
                <p class="mini-head">Likely causes</p>
                <ul class="causes">{s.causes.map((c) => <li>{c}</li>)}</ul>
              </div>
              <div>
                <p class="mini-head">Fix it, in this order</p>
                <ol class="fixes">
                  {s.fixes.map((f) => (
                    <li>
                      <strong>{f.step}.</strong> {f.detail}
                    </li>
                  ))}
                </ol>
              </div>
            </div>
            <p class="escalate">
              <strong>When to stop and get help:</strong> {s.escalate}
            </p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .common {
    max-width: 900px;
  }

  .common-title {
    color: var(--blue-700);
  }

  .symptom {
    padding: 24px 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 20px;
  }

  .sym-head {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .sym-head h3 {
    margin: 0;
    color: var(--blue-700);
  }

  .badge-serious {
    background: var(--coral-soft);
    color: var(--coral);
    border: 1px solid #f0cfc2;
  }

  .summary {
    color: var(--ink-soft);
    margin-bottom: 16px;
  }

  .cols {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 28px;
    margin-bottom: 16px;
  }

  .mini-head {
    font-family: var(--display);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sage-600);
    margin: 0 0 9px;
  }

  ul.causes,
  ol.fixes {
    margin: 0;
    padding-left: 20px;
    font-size: 0.93rem;
    color: var(--ink-soft);
  }

  ul.causes li,
  ol.fixes li {
    margin-bottom: 8px;
  }

  ol.fixes strong {
    color: var(--ink);
  }

  .escalate {
    margin: 0;
    background: #fff;
    border-left: 3px solid var(--sage-500);
    border-radius: 0 6px 6px 0;
    padding: 12px 16px;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  @media (max-width: 700px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  .stats {
    display: flex;
    gap: 26px;
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .stats strong {
    font-family: var(--display);
    font-size: 1.25rem;
    color: var(--blue-700);
    display: block;
    line-height: 1.1;
  }

  .group + .group {
    margin-top: 34px;
  }

  .group h2 {
    color: var(--blue-700);
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--blue-100);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 16px 18px;
    color: var(--ink);
  }

  .card:hover {
    border-color: var(--blue-500);
    box-shadow: var(--shadow-card);
    text-decoration: none;
  }

  .model {
    font-family: var(--display);
    font-size: 1.14rem;
  }

  .count {
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  .preview {
    list-style: none;
    margin: 10px 0 12px;
    padding: 0;
    font-size: 0.87rem;
    color: var(--ink-soft);
    flex: 1;
  }

  .preview li {
    padding-left: 14px;
    position: relative;
    margin-bottom: 4px;
  }

  .preview li::before {
    content: '·';
    position: absolute;
    left: 3px;
    color: var(--sage-600);
  }

  .cta {
    font-size: 0.86rem;
    color: var(--blue-700);
    margin-top: auto;
  }

  @media (max-width: 900px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
