---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductArt from '../../components/ProductArt.astro';
import BuyButtons from '../../components/BuyButtons.astro';
import { products, getProduct, getBrand } from '../../lib/catalog.js';
import { buildComparison, comparePairSlug } from '../../lib/compare.js';
import { formatScore, scoreBand, scoreLabel } from '../../lib/scoring.js';
import { costOverYears, annualRunningCost } from '../../lib/ownership.js';
import { productPath, comparePath } from '../../lib/routes.js';

export function getStaticPaths() {
  const paths = [];
  for (let i = 0; i < products.length; i += 1) {
    for (let j = i + 1; j < products.length; j += 1) {
      const a = products[i];
      const b = products[j];
      paths.push({ params: { pair: comparePairSlug(a, b) }, props: { aSlug: a.slug, bSlug: b.slug } });
    }
  }
  return paths;
}

const { aSlug, bSlug } = Astro.props;
// Alphabetical order matches the URL, so the left column is always predictable.
const [leftSlug, rightSlug] = [aSlug, bSlug].sort();
const a = getProduct(leftSlug);
const b = getProduct(rightSlug);
const c = buildComparison(a, b);
const brandA = getBrand(a.brand);
const brandB = getBrand(b.brand);

const groups = [];
for (const row of c.specRows) {
  let g = groups.find((x) => x.name === row.group);
  if (!g) {
    g = { name: row.group, rows: [] };
    groups.push(g);
  }
  g.rows.push(row);
}

const years = [1, 3, 5];
const title = a.model + ' vs ' + b.model;

const otherPairs = products
  .filter((p) => p.slug !== a.slug && p.slug !== b.slug)
  .slice(0, 4)
  .map((p) => ({ p, href: comparePath(a.slug, p.slug) }));
---

<BaseLayout
  title={title}
  description={'A field-by-field comparison of the ' + a.model + ' and the ' + b.model + ': specs, six category scores, running costs and which one suits which home.'}
>
  <header class="head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/compare/">Compare</a></li>
          <li><span>{title}</span></li>
        </ol>
      </nav>
      <h1>{title}</h1>
      <p class="lede">
        Every standardized field on both boxes, lined up. Nothing is retyped — both columns read from the
        same database as the reviews.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      <div class="versus">
        {
          [
            { p: a, brand: brandA, side: 'a' },
            { p: b, brand: brandB, side: 'b' },
          ].map(({ p, brand, side }) => {
            const overall = side === 'a' ? c.overall.a : c.overall.b;
            const isWinner = c.overall.winner === side;
            return (
              <div class={'vs-card ' + (isWinner ? 'is-winner' : '')}>
                {isWinner && <span class="crown">Higher overall</span>}
                <ProductArt product={p} size={150} />
                <p class="vs-brand">{brand?.name}</p>
                <h2 class="vs-name">
                  <a href={productPath(p.slug)}>{p.model}</a>
                </h2>
                <div class={'score score-lg is-' + scoreBand(overall)}>
                  <span class="score-value">{formatScore(overall)}</span>
                  <span class="score-caption">Overall</span>
                </div>
                <p class="vs-band">{scoreLabel(overall)}</p>
                <p class="vs-price">${p.price}</p>
                <BuyButtons product={p} compact={true} />
              </div>
            );
          })
        }
      </div>

      <h2 class="block-head">Scores side by side</h2>
      <div class="table-scroll">
        <table class="cmp">
          <thead>
            <tr>
              <th>Category</th>
              <th>{a.shortName || a.model}</th>
              <th>{b.shortName || b.model}</th>
            </tr>
          </thead>
          <tbody>
            {
              c.scoreRows.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  <td class={row.winner === 'a' ? 'win' : ''}>{formatScore(row.a)}</td>
                  <td class={row.winner === 'b' ? 'win' : ''}>{formatScore(row.b)}</td>
                </tr>
              ))
            }
            <tr class="overall-row">
              <th scope="row">Overall</th>
              <td class={c.overall.winner === 'a' ? 'win' : ''}>{formatScore(c.overall.a)}</td>
              <td class={c.overall.winner === 'b' ? 'win' : ''}>{formatScore(c.overall.b)}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2 class="block-head">Cost to own</h2>
      <div class="table-scroll">
        <table class="cmp">
          <thead>
            <tr>
              <th>Total spend after</th>
              <th>{a.shortName || a.model}</th>
              <th>{b.shortName || b.model}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Running cost per year</th>
              <td>${annualRunningCost(a)}</td>
              <td>${annualRunningCost(b)}</td>
            </tr>
            {
              years.map((y) => {
                const ca = costOverYears(a, y);
                const cb = costOverYears(b, y);
                return (
                  <tr>
                    <th scope="row">{y} year{y > 1 ? 's' : ''}</th>
                    <td class={ca < cb ? 'win' : ''}>${ca}</td>
                    <td class={cb < ca ? 'win' : ''}>${cb}</td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>

      <h2 class="block-head">Every specification</h2>
      <p class="muted small">Rows where the two differ are highlighted.</p>
      {
        groups.map((g) => (
          <div class="spec-group">
            <h3>{g.name}</h3>
            <div class="table-scroll">
              <table class="cmp">
                <tbody>
                  {g.rows.map((row) => (
                    <tr class={row.differs ? 'differs' : ''}>
                      <th scope="row">{row.label}</th>
                      <td>{row.a}</td>
                      <td>{row.b}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))
      }

      <h2 class="block-head">Which one, for whom</h2>
      <div class="fit-grid">
        {
          [a, b].map((p) => (
            <div class="fit-card">
              <h3>{p.model}</h3>
              <p class="fit-head good">Best for</p>
              <ul>{p.bestFor.map((x) => <li>{x}</li>)}</ul>
              <p class="fit-head bad">Not ideal for</p>
              <ul>{p.notIdealFor.map((x) => <li>{x}</li>)}</ul>
              <a class="btn btn-outline btn-block small-btn" href={productPath(p.slug)}>
                Full {p.shortName || p.model} review
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="wrap">
      <h2 class="block-head">Other comparisons</h2>
      <div class="others">
        {
          otherPairs.map(({ p, href }) => (
            <a class="other" href={href}>
              {a.shortName || a.model} vs {p.shortName || p.model}
            </a>
          ))
        }
        <a class="other other-tool" href="/compare/">Compare any two boxes →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .head {
    background: linear-gradient(180deg, var(--blue-050) 0%, #fff 100%);
    padding: 22px 0 30px;
    border-bottom: 1px solid var(--line-soft);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0 0 14px;
    padding: 0;
    font-size: 0.83rem;
    color: var(--ink-faint);
  }

  .crumbs li + li::before {
    content: '›';
    margin-right: 6px;
  }

  .crumbs a {
    color: var(--ink-soft);
  }

  .versus {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 38px;
  }

  .vs-card {
    position: relative;
    background: #fff;
    border: 2px solid var(--blue-100);
    border-radius: var(--radius);
    padding: 20px;
    text-align: center;
    box-shadow: var(--shadow-card);
  }

  .vs-card.is-winner {
    border-color: var(--sage-500);
  }

  .crown {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--sage-600);
    color: #fff;
    font-family: var(--display);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .vs-brand {
    margin: 6px 0 0;
    font-family: var(--display);
    font-size: 0.73rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--sage-600);
  }

  .vs-name {
    margin: 2px 0 12px;
    font-size: 1.3rem;
  }

  .vs-name a {
    color: var(--ink);
  }

  .vs-card .score {
    margin: 0 auto;
  }

  .vs-band {
    font-family: var(--display);
    margin: 10px 0 2px;
  }

  .vs-price {
    font-family: var(--display);
    font-size: 1.4rem;
    margin: 0 0 14px;
  }

  .block-head {
    color: var(--blue-700);
    margin: 34px 0 14px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--blue-100);
  }

  .table-scroll {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  table.cmp {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.93rem;
    min-width: 560px;
    table-layout: fixed;
  }

  .cmp thead th {
    background: var(--blue-050);
    font-family: var(--display);
    font-weight: 500;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue-700);
    text-align: left;
    padding: 11px 14px;
  }

  .cmp tbody th {
    text-align: left;
    font-weight: 400;
    color: var(--ink-soft);
    padding: 10px 14px;
    border-top: 1px solid var(--line-soft);
    width: 34%;
  }

  .cmp td {
    padding: 10px 14px;
    border-top: 1px solid var(--line-soft);
    width: 33%;
  }

  .cmp .win {
    background: var(--sage-050);
    font-weight: 600;
    color: var(--sage-600);
  }

  .overall-row th,
  .overall-row td {
    font-family: var(--display);
    font-size: 1.05rem;
    background: var(--bg-soft);
  }

  .differs td {
    background: #fffdf6;
  }

  .spec-group {
    margin-bottom: 20px;
  }

  .spec-group h3 {
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sage-600);
    margin: 18px 0 8px;
  }

  .fit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .fit-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 20px;
  }

  .fit-card h3 {
    margin-bottom: 12px;
  }

  .fit-head {
    font-family: var(--display);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 14px 0 6px;
  }

  .good {
    color: var(--sage-600);
  }

  .bad {
    color: var(--coral);
  }

  .fit-card ul {
    margin: 0;
    padding-left: 18px;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .fit-card li {
    margin-bottom: 4px;
  }

  .small-btn {
    padding: 9px 14px;
    font-size: 0.88rem;
    margin-top: 16px;
  }

  .others {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .other {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 8px 16px;
    font-size: 0.88rem;
    color: var(--ink);
  }

  .other:hover {
    border-color: var(--blue-500);
    text-decoration: none;
  }

  .other-tool {
    border-color: var(--sage-500);
    color: var(--sage-600);
  }

  @media (max-width: 760px) {
    .versus,
    .fit-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
